generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Repository {
  id            String   @id @default(cuid())
  githubId      Int      @unique
  name          String
  fullName      String
  owner         String
  url           String
  description   String?
  defaultBranch String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
